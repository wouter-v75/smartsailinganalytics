# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local — it's gitignored.
#
# See docs/auth/setup.md for where to find each value.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Public — bundled into the browser. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Bypasses Row-Level Security. Used by Vercel server functions
# for admin RPCs (approve user, set quota, etc.). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Bunny.net ─────────────────────────────────────────────────────────────
# Storage holds the session JSON, logs, photos and proxy MP4s; Stream holds the
# HLS renditions. All server-only — NEVER prefix any of these with NEXT_PUBLIC_.
#
# Omit BUNNY_STORAGE_WRITE_KEY to make the app read-only against Bunny: uploads
# go through /api/storage/credentials, which is the only route that uses it.

# Storage zone name, and the READ-ONLY password from
# Bunny → Storage → your zone → FTP & API Access.
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_API_KEY=
# Storage region code — "de" (Falkenstein, the default), "ny", "la", "sg"…
# Must match the zone's actual region or every read 404s.
# BUNNY_STORAGE_REGION=de
# The READ/WRITE password from the same page. Only needed to upload.
# BUNNY_STORAGE_WRITE_KEY=

# Stream library id and its API key, from Bunny → Stream → your library → API.
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_LIBRARY_ID=
# Signs the encoding-finished callback. Not needed for local development —
# Bunny cannot reach a laptop.
# BUNNY_STREAM_WEBHOOK_SECRET=

# Hostname that serves the Stream HLS playlists, e.g. vz-1234abcd.b-cdn.net
# (no scheme). Shown on the Stream library's page.
# BUNNY_CDN_HOSTNAME=

# Pull Zone hostname for serving signed video URLs (proxy + original).
# Example: ssa-videos.b-cdn.net  (no scheme, no trailing slash).
# NOTE: the hostname, not the zone's NAME. An older BUNNY_PULL_ZONE was never
# read by any code — if you have it set anywhere, it does nothing.
# BUNNY_PULL_HOST=

# Token-Authentication secret key, from the Pull Zone → Security tab.
# REQUIRED for signed-URL playback: without it /api/videos/<id>/url returns
# "Bunny token auth not configured" and nothing plays.
# Read it, do NOT toggle Token Authentication off and on to reveal it —
# Bunny ROTATES the key when you do, which invalidates the copy in Vercel.
# BUNNY_TOKEN_AUTH_KEY=

# ─── Resend (transactional email for invites) ──────────────────────────────
# Used to send targeted invitation emails. Sign up at resend.com, verify a
# sending domain (e.g. ssa.wvsailing.co.uk), then create an API key.
# Free tier: 3000 emails/mo, 100/day.
# Leave unset to skip email send (invites still create; team_manager copies
# the URL manually).
# RESEND_API_KEY=
# Sender shown in the From: header. Must be on a domain you've verified
# with Resend.
# RESEND_FROM=SSA <invites@ssa.wvsailing.co.uk>

# ─── Claude / Anthropic (forecast AI brief) ────────────────────────────────
# Server-side only (never NEXT_PUBLIC). Powers the exec summary on the forecast
# deck. Add in Vercel → Project → Settings → Environment Variables (Production),
# then REDEPLOY (env changes only apply to new builds). Health check:
#   GET /api/ai/forecast-summary  → { configured: true, model }
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-sonnet-4-6):
# ANTHROPIC_FORECAST_MODEL=claude-sonnet-4-6

# ─── Scaleway Generative APIs (debrief transcription + summary, sovereign EU) ──
# Server-side only (never NEXT_PUBLIC). Powers the speed-team debrief pipeline:
# audio → whisper-large-v3 transcription → Mistral summary → the three debrief
# fields. All inference stays inside your Scaleway (EU) account. Health checks:
#   GET /api/ai/transcribe        → { configured: true, model }
#   GET /api/ai/debrief-summary   → { configured: true, model }
# SCALEWAY_AI_API_KEY  = the Secret Key from the IAM key screen (the UUID),
#                        NOT the Access Key ID (SCWT…).
# SCALEWAY_AI_BASE_URL = project-scoped: https://api.scaleway.ai/<project-id>/v1
# SCALEWAY_AI_MODEL    = summary LLM. mistral-medium-3.5-128b is the best Mistral
#                        Scaleway carries and is what the summariser is tuned for;
#                        mistral-small-3.2-24b writes a note roughly a third the
#                        length and drops whole topics. ~31 s vs ~9 s per meeting.
# SCALEWAY_AI_API_KEY=
# SCALEWAY_AI_BASE_URL=https://api.scaleway.ai/YOUR-PROJECT-ID/v1
# SCALEWAY_AI_MODEL=mistral-medium-3.5-128b
# Optional — transcription model override (defaults to whisper-large-v3):
# SCALEWAY_TRANSCRIBE_MODEL=whisper-large-v3
# Optional — the model behind Analytics → "Ask the data" (/api/ai/ask). It is a
# separate variable from SCALEWAY_AI_MODEL so the analyst can be upgraded without
# moving the debrief summariser, which is tuned to its model. It must support TOOL
# CALLING: the whole design has the model pick a typed tool and fill arguments
# while SSA does the maths. Falls back to SCALEWAY_AI_MODEL, then to
# mistral-medium-3.5-128b.
# SCALEWAY_AI_ASK_MODEL=mistral-medium-3.5-128b

# Public site URL — canonical links, sitemap.xml, and the Open Graph card a
# forwarded link renders in WhatsApp/Slack. Defaults to the production host
# (https://ssa.wvsailing.co.uk) when unset, which is what production and every
# preview should normally report. Only set this if you genuinely want a build to
# name a different host, e.g. pointing a staging deploy at itself.
# NEXT_PUBLIC_SITE_URL=https://ssa.wvsailing.co.uk

# ── Wind OBSERVATIONS on the field map (src/app/api/obs/route.ts) ────────────
# Each network is independent and each is OPTIONAL: /api/obs uses
# Promise.allSettled, so a source with no key (or a network that is down) is
# simply absent from the answer and names itself in the response's `failed[]`.
# NOAA METAR (aviationweather.gov) needs NO key and is always on — so the map
# works with none of the below set.
#
# FFVL balises — ~200 French free-flight beacons, 5-minute cadence, dense along
# the Med coast where nothing official is. Open data but NOT keyless: an unkeyed
# call answers `error#3 : invalid FFVL key length`. Request one by email from
# informatique@ffvl.fr (state the use). The adapter is written and tested; the
# route skips the source entirely while this is unset.
# FFVL_API_KEY=
#
# Météo-France (portail-api.meteofrance.fr) — SYNOP land stations, and the only
# source of BUOY and SHIP observations, which are the two that actually sit on
# the water. API key, generated per application on the portal; France only.
# TRAP, from their own FAQ: a token only covers the APIs you had subscribed to
# WHEN IT WAS GENERATED. Subscribe to all of them first, then generate once, or
# the new endpoints 401 with a key that looks perfectly valid.
# METEOFRANCE_API_KEY=
#
# Davis WeatherLink (api.weatherlink.com/v2) — privately owned Davis stations:
# clubs, race offices, coastal houses. Drawn as the violet PWS tier because the
# siting is unknown however good the instrument is.
# BOTH are needed, and they go in different places: the key is a QUERY
# PARAMETER and the secret an X-Api-Secret HEADER. Send the secret any other way
# and it falls onto a legacy signed path that 401s about a timestamp.
# SCOPE: a key sees only what that ACCOUNT can see — stations it owns, ones
# shared with it, or public ones it paid to upgrade. It is a per-partner
# integration, not a global network: one club sharing its station is one barb.
# WEATHERLINK_API_KEY=
# WEATHERLINK_API_SECRET=
#
# Wind-observation poller (/api/obs/poll) — the shared secret a cron presents.
# The caller is a schedule, not a person, so this is a secret rather than a
# session. WITHOUT IT THE ROUTE REFUSES OUTRIGHT: an unprotected writer is how
# a table ends up full of whatever somebody felt like.
# Invoked every 30 min (obsSources POLL_EVERY_MIN must match this), either by
# cron on the regatta box:
#   0,30 * * * * curl -fsS -H "x-obs-poll-secret: $OBS_POLL_SECRET" \
#     https://ssa.wvsailing.co.uk/api/obs/poll >/dev/null 2>&1
# or by Vercel Cron, which signs with Authorization: Bearer <this>.
# OBS_POLL_SECRET=
#
#
# ── WeatherFile.com (the western Solent) ─────────────────────────────────────
# The ONLY source for the water west of Gurnard: the RLymYC starting platform,
# Hurst Castle in the narrows, Yarmouth Pier and Lymington Yacht Haven, plus
# Hythe, Stokes Bay, Calshot, Highcliffe and the Parkstone platform. Nine
# locations, one POST each, and each answers with the whole day at five-minute
# resolution — so a 6-hour graph is complete from the first poll.
#
# WITHOUT THIS KEY THE SOURCE MAKES NO REQUEST AT ALL and returns nothing, the
# same way a missing BUNNY_STORAGE_WRITE_KEY makes the app read-only against
# Bunny. That is deliberate: the API wants a `wf-tkn` header, their own page
# mints a six-character one against a PHP session, and automating that would be
# scripting around an access control on somebody's commercial service — so SSA
# does not. The reply does call these locations `"token": "PUBLIC"`, so they
# are not paywalled; ask support@weatherfile.com for a location API token
# (`/admin/location-api-tokens` is superadmin-only in their own app, so asking
# is the route).
# WEATHERFILE_TOKEN=
#
# ── Met Office Weather DataHub ───────────────────────────────────────────────
# Keys are JWTs and ALWAYS START `eyJ`. Check that after pasting: a paste that
# loses the leading character answers 500 "Unclassified Authentication Failure",
# which reads like a bad key rather than a truncated one and cost an hour.
# One key per PRODUCT, not per account — these two are different strings.
# Both go in an `apikey` HEADER.
#
# Land Observations (free plan, 360 calls/day, resets 00:00 UTC):
#   https://data.hub.api.metoffice.gov.uk/observation-land/1/nearest?lat=&lon=&max=
#   https://data.hub.api.metoffice.gov.uk/observation-land/1/<geohash>
# Measured 22 Oct 2026, none of it documented where we could reach it:
#   lat/lon take AT MOST 2 DECIMAL PLACES — more is a 400, not a rounding.
#   /nearest returns geohashes and area names with NO COORDINATES, so a
#     station's position has to be decoded from its geohash.
#   An observation is 48 HOURLY ROWS — two days of history in one call, which
#     is the real value here and the reason to poll it hourly, not every 15 min.
#   `wind_direction` is a COMPASS POINT STRING ("WSW"), not degrees: 22.5
#     granularity, and it needs converting.
#   UNITS ARE UNSTATED IN THE API AND ARE m/s, established by measurement:
#     373 paired hours against METAR at EIGHT UK airports, each compared with
#     ITS OWN nearest geohash, gave a median METAR_kn/value of 2.045 — against
#     1.94 for m/s, 1.00 for knots and 0.87 for mph. Every station fell between
#     1.73 and 2.82.
#     A FIRST ATTEMPT GOT THIS BACKWARDS, and the mistake is worth keeping: it
#     compared the geohash nearest COWES against the METAR at SOUTHAMPTON, two
#     different places, and read the location mismatch as a unit signal —
#     concluding 0.70, i.e. mph. One pair of stations cannot separate units
#     from siting. Pair each station with its own geohash, and use several.
#   Stations are ~50 km apart, so this is coarser than the METAR we already have.
# METOFFICE_API_KEY=
#
# Atmospheric Models (free plan, 1 GB/month):
#   https://data.hub.api.metoffice.gov.uk/atmospheric-models/1.0.0/orders
# ORDER-BASED, not query-based: an order is defined in the web UI (model,
# parameters, area, time steps, runs) and the API then serves that order's
# GRIB2 files. An empty `orders` array means no order exists yet, not a fault.
# Models: UK deterministic 2 km (UKV), Global deterministic 10 km, MOGREPS
# ensembles. For the Solent take the UKV LATITUDE-LONGITUDE variant — the
# standard one is on the rotated pole and needs reprojecting.
# NOTE this is a GRIB pipeline and belongs on the regatta box beside the ICON
# chain, which already has cdo and eccodes — not in a Vercel route.
# METOFFICE_ATMOS_API_KEY=
#
# MET Norway Frost (frost.met.no) — Norwegian land and coastal observations,
# CC BY 4.0. Needed for Viksfjord / Larvik, where NOTHING ELSE official
# reaches: NDBC is American, Météo-France is French, the Met Office is British,
# and the nearest METAR (ENTO, Torp) is an inland airport 9.8 nm off.
# NOT KEYLESS: every endpoint answers 401 without a client ID. Registration is
# free. AUTH IS HTTP BASIC WITH THE CLIENT ID AS THE USERNAME AND AN EMPTY
# PASSWORD — the secret is only for the OAuth2 token flow, so in normal use it
# is never sent at all. (id:secret also works; id: is the documented form.)
#
# THE BEST-DESCRIBED SOURCE WE HAVE. Per reading it states the UNIT ("m/s",
# "degrees"), the HEIGHT as level.height_above_ground, a qualityCode and an
# exposureCategory. Nothing else here publishes the anemometer height at all.
# Only qualityCode 0 is taken — Frost documents that as "the value is correct",
# and the other codes describe corrections we have not studied.
#
# NOT EVERY STATION MEASURES WIND, so sites are curated from
# /observations/availableTimeSeries rather than from /sources/nearest: of
# twelve within 8 nm of Viksfjord only FOUR carry wind, and only Svenner Fyr —
# a lighthouse — carries speed, direction AND gust together.
# Note api.met.no/weatherapi IS keyless but serves FORECASTS, not observations.
# FROST_CLIENT_ID=
# FROST_CLIENT_SECRET=
