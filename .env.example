# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local — it's gitignored.
#
# See docs/auth/setup.md for where to find each value.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Public — bundled into the browser. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Bypasses Row-Level Security. Used by Vercel server functions
# for admin RPCs (approve user, set quota, etc.). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Bunny.net (existing) ──────────────────────────────────────────────────
# Used for blob storage of photos / videos / logs. Continue to set as before.
# BUNNY_STORAGE_ZONE=
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE=

# ─── Resend (transactional email for invites) ──────────────────────────────
# Used to send targeted invitation emails. Sign up at resend.com, verify a
# sending domain (e.g. ssa.wvsailing.co.uk), then create an API key.
# Free tier: 3000 emails/mo, 100/day.
# Leave unset to skip email send (invites still create; team_manager copies
# the URL manually).
# RESEND_API_KEY=
# Sender shown in the From: header. Must be on a domain you've verified
# with Resend.
# RESEND_FROM=SSA <invites@ssa.wvsailing.co.uk>
