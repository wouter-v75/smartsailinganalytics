# Mac
.DS_Store
**/.DS_Store

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# Build outputs
/build

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.log
*.log

# Local env
.env
.env.local
.env*.local

# Vercel
.vercel

# Editor
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Misc
*.pem

# SailScan training set — only the parsed ground-truth/reference JSON files
# are tracked. The original photos and commercial-tool PDFs stay local.
/docs/sailscan/training-set/**/*.JPG
/docs/sailscan/training-set/**/*.jpg
/docs/sailscan/training-set/**/*.jpeg
/docs/sailscan/training-set/**/*.png
/docs/sailscan/training-set/**/*.heic
/docs/sailscan/training-set/**/*.HEIC
/docs/sailscan/training-set/**/*.pdf
/docs/sailscan/training-set/**/.DS_Store
videos2compress/

# ── Media scratch ────────────────────────────────────────────────────────────
# Drop clips here to triage them before uploading to SSA:
#     ./scripts/check-video-timestamps.sh media-in/
# Nothing in here is ever committed.
media-in/*
!media-in/.gitkeep

# Meeting audio + transcripts: private by definition, and the script writes them to
# ~/SSA/meetings by default. Ignored here too in case anyone points it at the repo.
*.wav
*.WAV
*.m4a
*.M4A
*.aiff
*.mp3

# Belt-and-braces: video files are never source, wherever they land in the tree.
# (A clip committed by accident is painful to remove from history.)
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.M4V
*.mts
*.MTS
*.avi
*.mkv

# The ONE exception: the public marketing site's own assets. These are not
# sailing footage being shuffled around — they are part of the page, they have
# to be in the deploy, and they are small and stable. Nothing else under
# public/ may carry video; keep this list explicit rather than widening it.
!public/media/hero-n76.mp4

# Real boat data for opt-in acceptance tests (client data, never committed)
/fixtures/local/

# Throwaway probes at the repo root (_dit, _nst, _rigtest, …) — one-off scripts
# for poking at a log or a Bunny response by hand. Root-level only, so a real
# file named _something.js inside src/ is still tracked.
/_*.js
